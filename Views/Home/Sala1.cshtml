@{
    ViewData["Title"] = "Sala 1";
}
    <section class="sala1">
        <h1 class="consigna">Estás atrapado en el labo de info, solo ves una hoja con secuencias logicas para completar. En la puerta hay botones que te piden completar un codigo para salir.</h1>
        <ul>
            @{int i = 0;}
            @foreach(SecuenciaSala1 sec in ViewBag.secuencias)
            {
                <li>
                    @if(ViewBag.adivinadas[i])
                    {
                        <h1>
                        @foreach(string s in sec.secuencia)
                        {
                            @($"{s} ")
                        }
                        </h1>
                    }else
                    {
                        <form action='@Url.Action("ValidarSecuencia", "Home")' method="post" required>
                            <h1>
                            @for(int j = 0; j < (sec.indiceRespuesta); j++)
                            {
                                @($"{sec.secuencia[j]} ")
                            }
                            </h1>
                            <input type="text" name="secuencia"/>
                            <input type="hidden" name="num" value="@i"/>
                            <h1>
                            @for(int k = (sec.indiceRespuesta + 1); k < sec.secuencia.Count; k++)
                            {
                                @($"{sec.secuencia[k]} ")
                            }
                            </h1>
                            <input type="submit" value="Adivinar">
                        </form>
                    }
                </li>
                i++;
            }
        </ul> 
        <a href='@Url.Action("IrPista", "Home")' class="bPista">Obtener pista</a>
        <form action='@Url.Action("PasarSala", "Home")' method="get" class="form-contraseña" required>
            Contraseña: <input type="text" name="contraseña"/>
            <input type="submit" value="Ingresar">
        </form>
</section>

@{
    ViewData["Title"] = "Sala 2";
}
<section class="sala2">
    <h1 class="consigna">Estás en el cuarto piso del edificio 1, resolviste el misterio de saber que hay detrás de la puerta con codigo, pero ahora vos tenes que adivinar el codigo de seguridad de la puerta</h1>
    <h1 class="consigna">Si en 15 intentos no descubris la clave cambia, apurate!</h1>
    <p>Intentos restantes: @(15 - ViewBag.intentos.Count)</p>
    @foreach (IntentoWordle intento in ViewBag.intentos)
    {
        <div class="intento">
            <p>Intento: @(intento.intento)</p>
            <p>Están en la posición correcta: @(intento.correctas)</p>
            <p>Están pero en la posición incorrecta: @(intento.estan)</p>
            <p>No están: @(intento.incorrectas)</p>
        </div>
    }
    <form method="post" action='@Url.Action("ValidarWordle", "Home")' class="form-contraseña" required>
        <input type="number" name="intento" min="10000" max="99999" />
        <input type="submit" value="Intentar"/>
    </form>
</section>
